# ============================================================
# .env.example — 环境变量配置示例文件
# ============================================================
# 作用：展示项目需要的环境变量有哪些，方便新开发者快速上手。
#       此文件会被提交到 Git，值一律填占位符，不暴露真实密钥。
# 用法：复制本文件 → 重命名为 .env → 填入真实值
# ============================================================

# ========== LLM 配置 ==========
# 语言模型 API 密钥（请替换为你的真实 API Key）
OPENAI_API_KEY=your-api-key-here
# API 基础地址（直接使用 127.0.0.1 本地代理或替换为云端地址）
OPENAI_BASE_URL=http://127.0.0.1:15721/v1
# 模型名称（格式：openai:<模型代号> ，使用 OpenAI 兼容协议）
MODEL_NAME=openai:gpt-5.4-mini
