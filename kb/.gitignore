# ============================================================
# .gitignore — Git 忽略规则文件
# ============================================================
# 作用：告诉 Git 哪些文件/目录不需要版本控制，不会被 add/commit。
# 规则是 glob 模式，每行一条，从上到下匹配。
# ============================================================

# 环境变量文件（包含 API 密钥等敏感信息，绝对不能提交）
.env
# Python 字节码缓存目录（运行时自动生成，提交无意义）
__pycache__/
# 编译后的 Python 字节码文件（运行时自动生成，提交无意义）
*.pyc
# Python 虚拟环境目录（依赖由 pyproject.toml + uv.lock 锁定，venv 无需提交）
.venv/



atguigu/import_process/nodes/node_pdf_to_md_full.py